{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Hauptfenster: nur die eigenen Commands und Core-Events (listen/unlisten), keine Plugins.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-ensure-inbox",
    "allow-list-task-lists",
    "allow-create-task-list",
    "allow-rename-task-list",
    "allow-move-task-list",
    "allow-delete-task-list",
    "allow-create-task",
    "allow-get-task",
    "allow-update-task",
    "allow-complete-task",
    "allow-move-task",
    "allow-delete-task",
    "allow-complete-tasks",
    "allow-delete-tasks",
    "allow-move-tasks",
    "allow-restore-tasks",
    "allow-set-dues",
    "allow-list-tasks",
    "allow-search-tasks",
    "allow-auth-info",
    "allow-auth-current",
    "allow-auth-begin-login",
    "allow-auth-open-browser",
    "allow-auth-poll-login",
    "allow-auth-cancel-login",
    "allow-auth-logout",
    "allow-sync-status",
    "allow-sync-now",
    "allow-set-online",
    "allow-app-ready",
    "allow-dev-selftest",
    "allow-dev-selftest-report"
  ]
}
