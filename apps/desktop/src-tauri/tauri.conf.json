{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tasks",
  "version": "0.1.0",
  "identifier": "dev.tasks.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tasks",
        "width": 1180,
        "height": 760,
        "minWidth": 480,
        "minHeight": 400,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "freezePrototype": true,
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
